{
  "name": "dsh-mobile-remote",
  "version": "3.1.5-eun.1",
  "description": "DSH Mobile：把 DeepSeek Harness 变成随身控制台——手机远程发消息派活、看进度、收通知、审批决策、管理会话；配套 Flutter App（Android 已发布；iOS 移植在 ios 分支，尚未正式发布）",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "README.md",
    "FAQ.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "mobile",
    "remote",
    "agent"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
